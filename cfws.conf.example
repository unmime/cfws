# cfws 配置示例
# 复制到 /etc/cfws/<worker>.conf，权限 600

WORKER=my-worker
ACCOUNT_ID=0000000000000000000000000000000
CF_TOKEN_FILE=/etc/cfws/cf.token
STATE_DIR=/var/lib/cfws/my-worker

# 健康检查：部署后请求不到预期内容就算失败，不记录版本，下次重试
VERIFY_URL=https://my-worker.example.com/ping
VERIFY_EXPECT=pong          # 含空格要加引号，如 "Cloud Mail"

# 目标 Worker 不存在时是否允许创建。默认 false（防止名字拼错静默新建）
# ALLOW_CREATE=false


# ============================================================
# 用法 A：direct —— 纯 JS，无构建、无静态资源（零依赖）
# 不配 MODE，只保留下面这段即自动走 direct
# ============================================================
UPSTREAM_URL=https://raw.githubusercontent.com/someone/some-worker/master/main.js
MAIN_MODULE=main.js
COMPAT_DATE=2026-03-01
COMPAT_FLAGS=nodejs_compat
KEEP_BINDINGS=d1,plain_text,kv_namespace,secret_text
MIN_BYTES=2000


# ============================================================
# 用法 B：wrangler —— 带静态资源或需要构建（依赖 node + git）
# 用这段时，把上面 A 段的 UPSTREAM_URL / MAIN_MODULE / COMPAT_* 删掉
# ============================================================
# MODE=wrangler
# SRC_GIT=https://github.com/you/your-project.git
# SRC_REF=main
# 或本地目录（与 SRC_GIT 二选一）：
# SRC_DIR=/opt/sites/your-project
# 构建命令：含空格必须整体加引号
# BUILD_CMD="pnpm install && pnpm build"
# WRANGLER_CONFIG=wrangler.jsonc
